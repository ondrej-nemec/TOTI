<root>
	<http>
		<port>82</port>
		<secured-port>445</secured-port>
		<thread-pool>100</thread-pool>
		<read-timeout>90000</read-timeout>
		<max-request-size>20480</max-request-size>
		<charset>UTF-8</charset>

		<key-store>
			<path>certificates/cert.p12</path>
			<password>betasecret</password>
			<type>PKCS12</type>
			<checkSNI>false</checkSNI>
		</key-store>
	</http>
	<applications>
		<examples>
			<resource-path>www</resource-path>
			<dir-allowed>true</dir-allowed>
			<dir-default-file>index.html</dir-default-file>
			<logs-path>logs</logs-path>
			<autostart>true</autostart>
			<headers>Access-Control-Allow-Origin:*</headers>
		</examples>
	</applications>
</root>